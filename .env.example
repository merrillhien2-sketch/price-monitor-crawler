# ============================================================
# 电商商品价格监控爬虫 - 环境配置示例
# ============================================================
# 使用方法：复制此文件为 .env，然后填写实际值
#   cp .env.example .env
#
# 注意：所有密码、密钥、Token 均从此文件读取，禁止硬编码到代码中
# ============================================================

# --- 数据库配置 ---
DATABASE_URL=sqlite:///data/price_monitor.db

# --- 日志配置 ---
LOG_LEVEL=INFO
LOG_DIR=data/logs

# --- 爬虫配置 ---
CRAWL_CONCURRENCY=5
CRAWL_TIMEOUT=30
CRAWL_RETRY=3
CRAWL_DELAY=1.0

# --- 代理IP配置 ---
PROXY_ENABLED=false
PROXY_API_URL=
PROXY_LIST=

# --- User-Agent池配置 ---
UA_POOL_ENABLED=true

# --- Cookie池配置 ---
COOKIE_POOL_ENABLED=false
COOKIE_LIST=

# --- 验证码配置 ---
CAPTCHA_ENABLED=false
CAPTCHA_API_URL=
CAPTCHA_API_KEY=

# --- 监控配置 ---
MONITOR_INTERVAL_MINUTES=30
PRICE_THRESHOLD=0

# --- 邮件通知配置 ---
NOTIFY_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=
NOTIFY_EMAILS=

# --- 解析配置（CSS选择器，可按目标网站自定义）---
SELECTOR_TITLE=h1.product-title
SELECTOR_PRICE=span.price
SELECTOR_ORIGINAL_PRICE=span.original-price
SELECTOR_STOCK=span.stock
